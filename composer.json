{
  "name": "illusiard/yii2-auditlog",
  "description": "Audit log extension for Yii2",
  "type": "yii2-extension",
  "license": "MIT",
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "require": {
    "php": "^8.5",
    "yiisoft/yii2": "^2.0.55"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "autoload": {
    "psr-4": {
      "illusiard\\auditlog\\": "src/"
    }
  },
  "extra": {
    "bootstrap": "illusiard\\auditlog\\Bootstrap"
  }
}
